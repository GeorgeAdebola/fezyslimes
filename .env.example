# Production / template environment variables
# Set VITE_* vars in Vercel → Project Settings → Environment Variables
# Set all other vars in Render → Environment (backend)
# Do NOT commit real secrets here – this file is a reference template only

# ----------------------------------------------------------------
# FRONTEND (exposed to browser – must start with VITE_)
# Set these in Vercel's Environment Variables dashboard
# ----------------------------------------------------------------

# Base URL of the deployed Express backend (no trailing slash)
VITE_API_BASE=https://fezyslimes-1n87.onrender.com

# ----------------------------------------------------------------
# BACKEND (server-side only – set these in Render's Environment tab)
# ----------------------------------------------------------------

# Admin credentials for the admin panel login
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=generate-a-unique-strong-password

# JWT signing secret (generate a long random string for production)
JWT_SECRET=generate-a-long-random-secret

# Comma-separated production frontend origin(s). Local Vite origins are
# always allowed for development.
# For production: https://fezyslimesshop.com,https://www.fezyslimesshop.com
ALLOWED_ORIGIN=https://fezyslimesshop.com,https://www.fezyslimesshop.com

# SMTP email sending credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FezySlimes <your-email@gmail.com>

# Google reCAPTCHA secret key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Cloudinary image hosting (for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase service account (for server-side Firebase Admin)
# Paste the entire JSON content as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"slime-business",...}
